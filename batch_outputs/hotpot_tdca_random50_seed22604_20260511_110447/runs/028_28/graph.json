        "title": "Pelican Point Power Station",
        "raw_score": 8.629628883876071,
        "source": "kg"
      }
    },
    {
      "node_id": "kg_doc_6",
      "node_type": "kg",
      "content": "The Lefevre Peninsula is a peninsula located in the Australian state of South Australia located about 15 km northwest of the Adelaide city centre. It is a narrow sand spit of about 30 square kilometres running north from its connection to the mainland.",
      "depth": 0,
      "parent_id": null,
      "value": 0.6086470660357981,
      "temperature": 0.6086470660357981,
      "expanded": false,
      "visit_count": 0,
