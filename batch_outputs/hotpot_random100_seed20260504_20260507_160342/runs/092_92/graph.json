    {
      "node_id": "kg_doc_8",
      "node_type": "kg",
      "content": "The Tales of Hoffmann is a 1951 British Technicolor film adaptation of Jacques Offenbach's opera \"The Tales of Hoffmann\", written, produced and directed by the team of Michael Powell and Emeric Pressburger working under the umbrella of their production company, The Archers.",
      "depth": 0,
      "parent_id": null,
      "value": 0.9999999979006476,
      "temperature": 0.9999999979006476,
      "expanded": false,
      "visit_count": 0,
      "persistent": true,
      "score_breakdown": {},
