    {
      "node_id": "kg_doc_8",
      "node_type": "kg",
      "content": "Mesilla Park is a neighborhood located on the south side of Las Cruces, New Mexico, United States. Residents of Mesilla founded the community through a land company in 1887, shortly after Las Cruces became the county seat of Doña Ana County. At the time, it was an independent settlement, though it was eventually annexed by Las Cruces. The neighborhood adjoins University Park, the site of New Mexico State University, and it grew after the university was founded in 1889. Mesilla Park still has its own post office with ZIP code 88047, which opened in 1892.",
      "depth": 0,
      "parent_id": null,
      "value": 0.9999999953642593,
      "temperature": 0.9999999953642593,
      "expanded": false,
      "visit_count": 0,
      "persistent": true,
      "score_breakdown": {},
