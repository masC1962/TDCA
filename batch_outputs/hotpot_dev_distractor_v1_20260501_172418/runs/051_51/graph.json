    {
      "node_id": "kg_doc_9",
      "node_type": "kg",
      "content": "Euromarché (\"Euromarket\") was a French hypermarket chain. The first store opened in 1968 in Saint-Michel-sur-Orge. In June 1991, the group was rebought by its rival, Carrefour, for 5,2 billion francs.",
      "depth": 0,
      "parent_id": null,
      "value": 0.9999999879430131,
