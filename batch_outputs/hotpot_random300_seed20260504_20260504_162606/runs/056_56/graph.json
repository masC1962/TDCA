    {
      "node_id": "kg_doc_10",
      "node_type": "kg",
      "content": "Gary Adrian Condit (born April 21, 1948) is a former politician and member of the Democratic Party who served in the House of Representatives from 1989 to 2003. Condit holds a B.B.A from the USC Marshall School of Business. Condit originally represented California's 15th congressional district, and then later California's 18th congressional district after redistricting following the 1990 census.",
      "depth": 0,
      "parent_id": null,
      "value": 0.9999999977926829,
      "temperature": 0.9999999977926829,
