    {
      "node_id": "kg_doc_10",
      "node_type": "kg",
      "content": "Shenandoah Valley Regional Airport (IATA: SHD, ICAO: KSHD, FAA LID: SHD) is a public airport located 10 nautical miles (12 mi, 19 km) northeast of the central business district of Staunton, a city in Augusta County, Virginia, United States. It is mostly used for general aviation, but is also served by one commercial airline. Service is subsidized by the Essential Air Service program.",
      "depth": 0,
      "parent_id": null,
