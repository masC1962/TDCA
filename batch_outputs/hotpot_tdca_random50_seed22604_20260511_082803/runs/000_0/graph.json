    {
      "node_id": "kg_doc_10",
      "node_type": "kg",
      "content": "The Black Seminoles are black Indians associated with the Seminole people in Florida and Oklahoma. They are the descendants of free blacks and of escaped slaves (called maroons) who allied with Seminole groups in Spanish Florida. Historically, the Black Seminoles lived mostly in distinct bands near the Native American Seminole. Some were held as slaves of particular Seminole leaders; but they had more freedom than did slaves held by whites in the South and by other Native American tribes, including the right to bear arms.",
      "depth": 0,
      "parent_id": null,
      "value": 0.9999999962835757,
      "temperature": 0.9999999962835757,
      "expanded": false,
      "visit_count": 0,
      "persistent": true,
      "score_breakdown": {},
      "metadata": {
        "title": "Black Seminoles",
        "raw_score": 6.912164903586376,
        "source": "kg"
      }
    },
    {
      "node_id": "kg_doc_1",
      "node_type": "kg",
      "content": "The Mascogos (also known as \"negros mascagos\") are an afrodescendant group in Coahuila, Mexico. Centered on the town of El Nacimiento in Múzquiz Municipality, the group are descendants of Black Seminoles escaping the threat of slavery in the United States.",
      "depth": 0,
      "parent_id": null,
      "value": 0.9999999958586308,
      "temperature": 0.9999999958586308,
