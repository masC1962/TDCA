    {
      "node_id": "kg_doc_5",
      "node_type": "kg",
      "content": "The Boren-McCurdy intelligence reform proposals are two legislative proposals from Senator David Boren and Representative David McCurdy in 1992 (102nd Congress). Both pieces of legislation propose the creation of a National Intelligence Director. Neither bill passed into law.",
      "depth": 0,
      "parent_id": null,
      "value": 0.9999999983890423,
      "temperature": 0.9999999983890423,
      "expanded": false,
      "visit_count": 0,
