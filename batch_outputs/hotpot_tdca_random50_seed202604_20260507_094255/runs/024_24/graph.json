    {
      "node_id": "kg_doc_3",
      "node_type": "kg",
      "content": "Filming 'The Trial' is an unfinished making-of film by Orson Welles, made in 1981, which focuses on the production of his 1962 film \"The Trial\".",
      "depth": 0,
      "parent_id": null,
      "value": 0.999999997691432,
      "temperature": 0.999999997691432,
