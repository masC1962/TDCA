    {
      "node_id": "kg_doc_1",
      "node_type": "kg",
      "content": "The Bristol 403 is a luxury car which was produced from 1953 to 1955 by British manufacturer Bristol Aeroplane Co. (whose car division later became Bristol Cars). The 403 was the third of the eventual five series of Bristols powered by the BMW-derived pushrod straight-six engine. It replaced the Bristol 401 and 402 in 1953 and continued in production for two years.",
      "depth": 0,
      "parent_id": null,
      "value": 0.9133714286776494,
      "temperature": 0.9133714286776494,
      "expanded": false,
      "visit_count": 0,
