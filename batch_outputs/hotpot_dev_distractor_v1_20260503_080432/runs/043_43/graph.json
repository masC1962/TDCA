    {
      "node_id": "kg_doc_6",
      "node_type": "kg",
      "content": "The Battle of Adwa (Amharic: አድዋ; Amharic translated: Adowa, or sometimes by the Italian name \"Adua\") was fought on 2 March 1896/Yekatit 23, 1889 according to Ethiopian calendar between the Ethiopian Empire and the Kingdom of Italy near the town of Adwa, Ethiopia, in Tigray. This climactic battle of the First Italo-Ethiopian War, was a decisive defeat for Italy and secured Ethiopian sovereignty.",
      "depth": 0,
      "parent_id": null,
      "value": 0.999999973699853,
      "temperature": 0.999999973699853,
      "expanded": false,
      "visit_count": 0,
      "persistent": true,
      "score_breakdown": {},
