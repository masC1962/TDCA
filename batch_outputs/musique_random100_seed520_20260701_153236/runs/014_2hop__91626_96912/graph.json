    {
      "node_id": "kg_doc_8",
      "node_type": "kg",
      "content": "The Adam Smith Prize are two prizes for best performance in the Part IIB Economics Tripos examinations and dissertation at the University of Cambridge, Cambridge, England. Previously the prize, established in 1891 and named after Adam Smith, was awarded triennially for best submitted essay on a subject of the writer's choice.",
      "depth": 0,
      "parent_id": null,
      "value": 0.9999999819155488,
