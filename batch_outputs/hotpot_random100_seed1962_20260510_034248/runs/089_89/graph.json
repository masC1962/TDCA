    {
      "node_id": "kg_doc_4",
      "node_type": "kg",
      "content": "Navy–Marine Corps Memorial Stadium is an open-air stadium located on the campus of the United States Naval Academy in Annapolis, Maryland. Opened in 1959, it serves as the home stadium of the Navy Midshipmen college football and lacrosse, and the professional Chesapeake Bayhawks of Major League Lacrosse. The stadium is also the host of the Military Bowl.",
      "depth": 0,
      "parent_id": null,
      "value": 0.9999999977081137,
