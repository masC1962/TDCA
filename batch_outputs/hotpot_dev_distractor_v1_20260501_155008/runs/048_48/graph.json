    {
      "node_id": "kg_doc_8",
      "node_type": "kg",
      "content": "Ferocactus is a genus of large barrel-shaped cacti, mostly with large spines and small flowers. There are about 30 species included in the genus. They are found in the southwestern United States and northwestern Mexico.",
      "depth": 0,
      "parent_id": null,
      "value": 0.9999999929305405,
